{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token-shrinker.dev/schemas/tool-descriptor-v1.json",
  "title": "Token-Shrinker tool descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "displayName", "authoritativeSource", "ownership", "capabilities", "releaseDiscovery", "healthProbe"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "authoritativeSource": {
      "type": "string",
      "format": "uri"
    },
    "ownership": {
      "enum": ["npm", "cargo", "manual", "external", "token_shrinker_managed"]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["context", "memory", "compression", "terminal", "tokenizer"]
      }
    },
    "releaseDiscovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository"],
      "properties": {
        "kind": {
          "const": "github_releases"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        }
      }
    },
    "healthProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "arguments"],
      "properties": {
        "kind": {
          "const": "version_argument"
        },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

