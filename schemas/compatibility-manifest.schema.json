{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token-shrinker.dev/schemas/compatibility-manifest-v1.json",
  "title": "Token-Shrinker compatibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "expiresAt", "components", "signature"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "authoritativeSource", "ownership", "releases"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "authoritativeSource": {
          "type": "string",
          "format": "uri"
        },
        "ownership": {
          "enum": ["npm", "cargo", "manual", "external", "token_shrinker_managed"]
        },
        "releases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/release"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "channel", "protocol", "artifacts"],
      "properties": {
        "version": {
          "type": "string"
        },
        "channel": {
          "enum": ["stable", "beta", "alpha"]
        },
        "protocol": {
          "$ref": "#/$defs/protocolRange"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "protocolRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {
          "type": "string"
        },
        "max": {
          "type": "string"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "url", "sha256"],
      "properties": {
        "platform": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "keyId": {
          "type": "string"
        },
        "value": {
          "type": "string",
          "contentEncoding": "base64"
        }
      }
    }
  }
}

