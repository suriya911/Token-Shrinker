{
  "name": "@token-shrinker/sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for the local Token-Shrinker MCP and daemon transports.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/suriya911/Token-Shrinker.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/suriya911/Token-Shrinker#readme",
  "bugs": "https://github.com/suriya911/Token-Shrinker/issues",
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/protocol.js",
    "dist/protocol.js.map",
    "dist/protocol.d.ts",
    "dist/protocol.d.ts.map",
    "dist/LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('../../LICENSE','dist/LICENSE')\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.mjs"
  }
}
